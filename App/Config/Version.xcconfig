// アプリのバージョン（D142）。
// リリースのビルドでは、Xcode Cloud がタグ（v1.2.3）から書き換える（ci_scripts/ci_pre_xcodebuild.sh）。
// 手元のビルドは 0.0.0 のまま。ビルド番号は Xcode Cloud が付ける。
MARKETING_VERSION = 0.0.0

// クラッシュの報告（Sentry）の送り先（D183・D198）。DSN は公開してよい値なので、ここに書いて入れる（D198）。
// DEBUG のビルドと UI テストは、この値があっても Sentry を動かさず、何も送らない（CrashReporting.start）。
// 値に `//` があると、xcconfig ではコメントになる。そのため `https:/$()/…` と書く。
SENTRY_DSN = https:/$()/60a47c89b77025e16b013bdb0885b5af@o259380.ingest.us.sentry.io/4512508344401920
