    "お問い合わせのフォームを Safari で開きます。調べるために、アプリの版と iPadOS の版を入れておきます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the contact form in Safari. The app version and iPadOS version are filled in to help us look into it."
          }
        }
      }
    },
    "お子さま": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your child"
          }
        }
      }
    },
    "お子さまからのおねがい": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests from your child"
