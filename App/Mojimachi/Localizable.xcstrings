          }
        }
      }
    },
    "6人まで登録できます。記録は子どもごとに分けて保存します。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add up to 6 children. Records are kept separately for each child."
          }
        }
      }
    },
    "ABC・数字": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ABC & Numbers"
          }
        }
      }
    },
    "OK": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
