{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>aquaproj/aqua-renovate-config#2.14.0"
  ],
  // Whole first week of the month: Mend Community jobs only run every few
  // days at arbitrary times.
  "schedule": [
    "* * 1-7 * *"
  ],
  // Wait two weeks after a release before proposing it, except for security fixes (D104).
  "minimumReleaseAge": "14 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  },
  // A human reviews the changelog and runs the tests before merging (D104).
  "automerge": false
}
